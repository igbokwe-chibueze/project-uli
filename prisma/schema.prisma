generator client {
  provider   = "prisma-client-js"
  //This according to chatgpt means there’s no child process to kill, and you won’t see EPERM errors.
  //remove later
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  firstName             String?
  lastName              String?
  email                 String                 @unique
  emailVerified         DateTime?
  image                 String?
  bio                   String?
  password              String?
  passwordChangedAt     DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  isTwoFactorEnabled    Boolean                @default(false)
  role                  UserRole               @default(USER)
  countryId             String?
  platformInviteId      String?                @unique
  accounts              Account[]
  addresses             Address[]
  OrgInviteToken        OrgInviteToken[]
  organizations         OrganizationMember[]
  invitesSent           PlatformInviteToken?   @relation("PlatformInvitesByUser")
  sessions              Session[]
  twoFactorConfirmation TwoFactorConfirmation?
  country               Country?               @relation(fields: [countryId], references: [id])
  platformInvite        PlatformInviteToken?   @relation("PlatformInviteForUser", fields: [platformInviteId], references: [id])
  userCertifications    UserCertification[]
  userLanguages         UserLanguage[]
  userSocialLinks       UserSocialLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationTokenCustom {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// PlatformInviteToken: invites to join the app platform (not tied to any specific organization).
model PlatformInviteToken {
  id           String   @id @default(cuid())
  token        String   @unique
  createdAt    DateTime @default(now())
  invitedById  String   @unique
  role         UserRole @default(USER)
  invitedBy    User     @relation("PlatformInvitesByUser", fields: [invitedById], references: [id], onDelete: Cascade)
  inviteeUsers User?    @relation("PlatformInviteForUser")
}

/// Countries (e.g. "Nigeria", "France"), extended to store full reference data
model Country {
  id             String         @id @default(cuid())
  name           String         @unique
  iso2           String?        @unique @map("iso2")
  iso3           String?        @unique @map("iso3")
  numericCode    String?        @map("numeric_code")
  phoneCode      String?        @map("phone_code")
  capital        String?
  currency       String?
  currencyName   String?        @map("currency_name")
  currencySymbol String?        @map("currency_symbol")
  tld            String?        @map("tld")
  nativeName     String?        @map("native")
  region         String?
  regionId       String?        @map("region_id")
  subregion      String?
  subregionId    String?        @map("subregion_id")
  nationality    String?
  latitude       Decimal?       @map("latitude")
  longitude      Decimal?       @map("longitude")
  emoji          String?
  emojiU         String?        @map("emojiU")
  timezones      Json?
  translations   Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Address        Address[]
  organizations  Organization[]
  users          User[]
  states         State[]

  @@map("countries")
}

/// Country States (e.g. provinces, districts)
model State {
  id            String         @id @default(cuid())
  name          String
  stateCode     String?        @map("state_code")
  type          String?
  latitude      Decimal?       @map("latitude")
  longitude     Decimal?       @map("longitude")
  countryId     String         @map("country_id")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[] @relation("StateToOrgs")
  country       Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId], map: "idx_states_country")
  @@map("states")
}

/// Organization Types (e.g. "Nonprofit", "Corporate", "Government")
model OrganizationType {
  id            String         @id @default(cuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  organizations Organization[]
}

/// Industries (e.g. "Pharmaceutical", "Finance")
model Industry {
  id            String         @id @default(cuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  organizations Organization[]
}

/// Employee Count Ranges (e.g. "1-10", "11-50", "51-200")
model EmployeeCountRange {
  id            String         @id @default(cuid())
  label         String         @unique
  minCount      Int?
  maxCount      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  organizations Organization[]
}

/// Revenue Ranges (e.g. "$0K-$100K", "$100K-$1M")
model RevenueRange {
  id            String         @id @default(cuid())
  label         String         @unique
  minRevenue    Int?
  maxRevenue    Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  organizations Organization[]
}

/// ColorScheme (e.g. "theme-velvet", "theme-sky")
model ColorScheme {
  id            String         @id @default(cuid())
  name          String         @unique
  primaryOklch  String         @default("") @db.VarChar(50)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  organizations Organization[]
}

/// Languages (e.g. "English", "French", "Spanish")
model Language {
  id           String  @id @default(cuid())
  name         String  @unique
  languageCode String? @unique /// ISO 639-1 language code, e.g. "en", "fr"
  countryCode  String? /// Optional ISO 3166-1 alpha-2 code for flag icons (e.g. "gb" for English)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Many‐to‐many: users who speak these languages
  userLanguages UserLanguage[]

  // Many‐to‐many: orgs that support these languages
  organizationLanguages OrganizationLanguage[]
}

/// Specialties (e.g. "Quality Assurance", "Regulatory Affairs")
model Specialty {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now())
  organizationSpecialties OrganizationSpecialty[]
}

/// Certifications (e.g. "ISO 9001", "ISO 45001", "GMP")
model Certification {
  id                         String                      @id @default(cuid())
  name                       String                      @unique
  issuer                     String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @default(now())
  organizationCertifications OrganizationCertification[]
  userCertifications         UserCertification[]
}

/// Social Media Platforms (Admins can add “TikTok”, “YouTube”, etc.)
model SocialPlatform {
  id              String                   @id @default(cuid())
  name            String                   @unique
  domain          String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @default(now())
  orgSocialLinks  OrganizationSocialLink[]
  userSocialLinks UserSocialLink[]
}

/// User ⟷ Language (which languages a user speaks)
model UserLanguage {
  userId     String
  languageId String
  fluency    String?
  createdAt  DateTime @default(now())
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, languageId])
}

/// User ⟷ Certification (which certs a user holds)
model UserCertification {
  userId          String
  certificationId String
  obtainedAt      DateTime?
  expiresAt       DateTime?
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, certificationId])
}

/// Organization ⟷ Language (which languages an organization supports)
model OrganizationLanguage {
  orgId        String
  languageId   String
  createdAt    DateTime     @default(now())
  language     Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, languageId])
}

/// Organization ⟷ Specialty (which specialties an organization lists)
model OrganizationSpecialty {
  orgId        String
  specialtyId  String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  specialty    Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([orgId, specialtyId])
}

/// Organization ⟷ Certification (which certs an organization holds)
model OrganizationCertification {
  orgId           String
  certificationId String
  obtainedAt      DateTime?
  expiresAt       DateTime?
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, certificationId])
}

/// “Branches” are physical or logical locations under a single Organization.
/// They share the same country as the parent org (validated in application code).
model Branch {
  id           String       @id @default(cuid())
  orgId        String
  name         String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  address      Address?     @relation("BranchAddress")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Join table: Organization ⟷ Organization (to list contractors)
/// Example: Org A contracts Org B
model OrganizationContractor {
  id           String       @id @default(cuid())
  orgId        String
  contractorId String
  createdAt    DateTime     @default(now())
  contractor   Organization @relation("ContractorToOrgs", fields: [contractorId], references: [id], onDelete: Cascade)
  organization Organization @relation("OrgToContractors", fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, contractorId])
}

model Address {
  id             String        @id @default(cuid())
  street         String
  city           String
  state          String?
  postalCode     String?
  countryId      String
  userId         String?
  organizationId String?
  branchId       String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  branch         Branch?       @relation("BranchAddress", fields: [branchId], references: [id], onDelete: Cascade)
  country        Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One social‐link record per platform per organization
model OrganizationSocialLink {
  id           String         @id @default(cuid())
  orgId        String
  platformId   String
  url          String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  platform     SocialPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([orgId, platformId])
}

/// One social‐link record per platform per user
model UserSocialLink {
  id         String         @id @default(cuid())
  userId     String
  platformId String
  url        String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   SocialPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([userId, platformId])
}

/// Departments within an Organization
model Department {
  id           String       @id @default(cuid())
  orgId        String
  name         String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  units        Unit[]

  // Relation to OrganizationMember
  members OrganizationMember[]
}

/// Units within a Department
model Unit {
  id           String     @id @default(cuid())
  departmentId String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Relation to OrganizationMember
  members OrganizationMember[]

  @@unique([departmentId, name])
}

model Organization {
  id                     String                      @id @default(cuid())
  name                   String                      @unique
  description            String?
  logo                   String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  /// Foreign keys to lookup tables (countryId made optional)
  countryId              String?
  employeeCountRangeId   String?
  industryId             String?
  orgTypeId              String?
  /// Self‐relation for “affiliations” (cross‐country sister companies)
  parentOrgId            String?
  revenueRangeId         String?
  allowContact           Boolean                     @default(true)
  alternateEmail         String?
  alternatePhoneNumber   String?
  foundedYear            Int?
  isPublicProfile        Boolean                     @default(true)
  newsletterSubscription Boolean                     @default(false)
  operationalHours       Json?
  phoneNumber            String?
  primaryEmail           String?
  registrationNumber     String?
  showRevenue            Boolean                     @default(false)
  isActive               Boolean                     @default(true)
  socialMediaLinks       Json?
  taxId                  String?
  website                String?
  stateId                String?
  streetAddress1         String?
  streetAddress2         String?
  colorSchemeId          String?
  addresses              Address[]
  audits                 Audit[]
  branches               Branch[]
  departments            Department[]
  incidents              Incident[]
  orgInvites             OrgInviteToken[]
  colorScheme            ColorScheme?                @relation(fields: [colorSchemeId], references: [id])
  country                Country?                    @relation(fields: [countryId], references: [id])
  employeeCountRange     EmployeeCountRange?         @relation(fields: [employeeCountRangeId], references: [id])
  industry               Industry?                   @relation(fields: [industryId], references: [id])
  orgType                OrganizationType?           @relation(fields: [orgTypeId], references: [id])
  parentOrg              Organization?               @relation("OrgAffiliations", fields: [parentOrgId], references: [id], onDelete: Cascade)
  affiliations           Organization[]              @relation("OrgAffiliations")
  revenueRange           RevenueRange?               @relation(fields: [revenueRangeId], references: [id])
  state                  State?                      @relation("StateToOrgs", fields: [stateId], references: [id])
  certifications         OrganizationCertification[]
  contractedBy           OrganizationContractor[]    @relation("ContractorToOrgs")
  contractors            OrganizationContractor[]    @relation("OrgToContractors")
  languages              OrganizationLanguage[]
  members                OrganizationMember[]
  modules                OrganizationModule[]
  orgSocialLinks         OrganizationSocialLink[]
  specialties            OrganizationSpecialty[]
}

/// Tracks which user belongs to which organization (and their OrgRole)
model OrganizationMember {
  id                  String    @id @default(cuid())
  orgId               String
  userId              String
  orgEmail            String?   @unique // Organization-specific email
  role                OrgRole   @default(MEMBER)
  joinedAt            DateTime  @default(now())
  orgBio              String? // New: Bio specific to this organization
  staffNumber         String?
  orgProfilePicture   String? // New: Profile picture specific to this organization
  internalPhoneNumber String? // New: Internal phone number
  internalExtension   String? // New: Internal extension
  startDate           DateTime? // New: Start date in this organization
  departmentId        String? // New: Relation to Department
  unitId              String? // New: Relation to Unit

  audits       Audit[]
  assigneeOf   Incident[]   @relation("Assignee")
  reporterOf   Incident[]   @relation("Reporter")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])

  @@unique([orgId, userId])
  @@unique([orgId, orgEmail])
}

model OrgInviteToken {
  id           String       @id @default(cuid())
  email        String?
  token        String       @unique
  expires      DateTime?
  createdAt    DateTime     @default(now())
  orgId        String
  role         OrgRole      @default(MEMBER)
  acceptedById String?
  acceptedAt   DateTime?
  acceptedBy   User?        @relation(fields: [acceptedById], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// This defines what modules are AVAILABLE in your ecosystem.
model Module {
  id                  String               @id @default(cuid())
  type                ModuleType           @unique // e.g., "HRMS", "HSEMS", "QMS" - Used for routing and dynamic imports
  name                String // e.g., "Human Resources Management System" - User-friendly name
  description         String? // Detailed description for the marketplace
  icon                String? // SVG path or icon name (e.g., 'FaUsers' for FontAwesome, or "UsersIcon")
  version             String               @default("1.0.0") // For future upgrades and compatibility
  isActive            Boolean              @default(true) // Can be disabled globally by platform admin
  isFree              Boolean              @default(true) // For marketplace display
  price               Decimal? // For marketplace display
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationModules OrganizationModule[]
}

// --- Organization-Module Relationship (Tracks 'Installed' Modules per Org) ---
// This represents an organization's specific installation of a module.
model OrganizationModule {
  id           String       @id @default(cuid())
  orgId        String
  moduleId     String
  isEnabled    Boolean      @default(true) // Allows an org to temporarily disable an installed module
  installedAt  DateTime     @default(now())
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, moduleId])
}

model Incident {
  id           String              @id @default(cuid())
  orgId        String
  reporterId   String
  assigneeId   String?
  title        String
  description  String
  severity     IncidentSeverity    @default(LOW)
  location     String?
  dateOccurred DateTime
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assignee     OrganizationMember? @relation("Assignee", fields: [assigneeId], references: [id])
  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reporter     OrganizationMember  @relation("Reporter", fields: [reporterId], references: [id])
}

model Audit {
  id              String             @id @default(cuid())
  orgId           String
  auditorId       String
  title           String
  scope           String?
  dateScheduled   DateTime
  dateCompleted   DateTime?
  findings        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  auditor         OrganizationMember @relation(fields: [auditorId], references: [id])
  organization    Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nonConformities NonConformity[]
}

model NonConformity {
  id               String   @id @default(cuid())
  auditId          String
  description      String
  rootCause        String?
  correctiveAction String?
  preventiveAction String?
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  audit            Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  USER
}

enum OrgRole {
  OWNER
  MANAGER
  AUDITOR
  MEMBER
}

enum ModuleType {
  HRMS
  HSEMS
  QMS
  CRM
  PMS
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
